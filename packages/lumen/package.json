{
  "name": "@sanad/lumen",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Lumen: Sanad's secure reader engine (WebGL2 renderer, workers, vault crypto).",
  "exports": {
    ".": "./src/index.ts",
    "./gl/*": "./src/gl/*.ts",
    "./vault/*": "./src/vault/*.ts",
    "./input/*": "./src/input/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@sanad/lumen-wasm": "workspace:*"
  }
}
