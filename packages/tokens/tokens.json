{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Marginalia reading themes. Source of truth for the reader chrome (CSS custom properties), app logic (TS constants) and the Lumen Pass 3 composite (shader uniforms). OKLCH components are authoritative; every hex is their exact 8-bit sRGB rounding (enforced at build). Generated outputs: never hand-edit. Spec: docs/blueprint/04-design-system.md §4.",
  "$extensions": {
    "app.sanad": {
      "defaults": { "light": "paper", "dark": "night" }
    }
  },
  "theme": {
    "paper": {
      "$extensions": {
        "app.sanad": {
          "label": "Paper",
          "mode": "light",
          "imagePolicy": "natural"
        }
      },
      "color": {
        "$type": "color",
        "paper": {
          "$description": "Page background. Also the Pass 3 u_paper uniform.",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.985, 0.0041, 91.4],
            "hex": "#fbfaf7"
          }
        },
        "ink": {
          "$description": "Primary text (ink role 0).",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.2268, 0.0041, 84.6],
            "hex": "#1d1c1a"
          }
        },
        "ink-2": {
          "$description": "Secondary text: running heads, folios, captions (ink role 1).",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.4691, 0.0122, 81.8],
            "hex": "#5e5a53"
          }
        },
        "accent": {
          "$description": "Links, progress, focus, search matches (ink role 2). The theme's only accent.",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.4674, 0.0893, 249.8],
            "hex": "#2f5d8a"
          }
        },
        "highlight-1": {
          "$description": "Highlight underlay 1 (yellow); u_highlight[0].",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.9274, 0.0877, 97.2],
            "hex": "#f7e8a4"
          }
        },
        "highlight-2": {
          "$description": "Highlight underlay 2 (green); u_highlight[1].",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.9106, 0.0543, 140.1],
            "hex": "#cfebc9"
          }
        },
        "highlight-3": {
          "$description": "Highlight underlay 3 (blue); u_highlight[2].",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.9005, 0.0342, 253.7],
            "hex": "#cfe0f5"
          }
