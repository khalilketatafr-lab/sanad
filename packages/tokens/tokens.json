        "highlight-4": {
          "$description": "Highlight underlay 4 (rose); u_highlight[3].",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.8979, 0.0397, 0.1],
            "hex": "#f5d3dc"
          }
        },
        "surface-1": {
          "$description": "Raised chrome surface; solid fallback for glass (reduced transparency, Tier C).",
          "$value": {
            "colorSpace": "oklch",
            "components": [1, 0, 0],
            "hex": "#ffffff"
          }
        },
        "surface-2": {
          "$description": "Second elevation step.",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.9616, 0.0057, 84.6],
            "hex": "#f4f2ee"
          }
        },
        "ink-2-on-glass": {
          "$description": "Secondary labels on glass; holds ≥ 5.4:1 over the worst-case backdrop.",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.4147, 0.0111, 78.2],
            "hex": "#4f4b45"
          }
        },
        "glass-tint": {
          "$description": "Frosted-vellum fill. Alpha is the legibility floor: primary labels ≥ 7:1 over the worst-case backdrop.",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.985, 0.0041, 91.4],
            "alpha": 0.88,
            "hex": "#fbfaf7"
          },
          "$extensions": {
            "app.sanad": {
              "derivedFrom": "theme.paper.color.paper"
            }
          }
        },
        "hairline": {
          "$description": "1 px separators and glass borders.",
          "$value": {
            "colorSpace": "oklch",
            "components": [0.2268, 0.0041, 84.6],
            "alpha": 0.1,
            "hex": "#1d1c1a"
          },
          "$extensions": {
            "app.sanad": {
              "derivedFrom": "theme.paper.color.ink"
            }
          }
        }
      },
      "shadow": {
        "focus-ring": {
          "$type": "shadow",
          "$description": "Visible focus indicator (box-shadow); never removed. Accent at 80%: ≥ 3:1 against paper, both surfaces and glass (WCAG 2.2 SC 1.4.11).",
          "$value": {
            "color": {
              "colorSpace": "oklch",
              "components": [0.4674, 0.0893, 249.8],
              "alpha": 0.8,
              "hex": "#2f5d8a"
            },
            "offsetX": { "value": 0, "unit": "px" },
            "offsetY": { "value": 0, "unit": "px" },
            "blur": { "value": 0, "unit": "px" },
            "spread": { "value": 3, "unit": "px" }
          },
          "$extensions": {
            "app.sanad": {
              "derivedFrom": "theme.paper.color.accent"
            }
          }
        }
      },
      "shader": {
        "$description": "Lumen Pass 3 composite uniforms (packages/lumen/src/gl/shaders.ts). Warmth and extra-dim are reader settings, not theme tokens.",
        "covGamma": {
          "$type": "number",
          "$value": 0.9,
          "$description": "Coverage curve exponent: < 1 sturdier dark-on-light, > 1 crisper light-on-dark."
        },
        "weight": {
          "$type": "dimension",
          "$value": { "value": 0.05, "unit": "px" },
          "$description": "Optical weight compensation: MSDF edge offset in screen px (u_weightPx; + bolder, − thinner)."
        },
        "lumaCeil": {
          "$type": "number",
          "$value": 1,
          "$description": "Anti-glare ceiling (linear Y); ≥ the paper's luminance, so the page itself is never dimmed."
        }
